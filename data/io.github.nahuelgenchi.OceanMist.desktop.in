[Desktop Entry]
Type=Application
Name=Ocean Mist
GenericName=Music Player
Comment=Play music with the look of the classic Windows Media Player 9
Exec=/usr/bin/python3 @OCEAN_MIST_DIR@/player.py %F
Icon=io.github.nahuelgenchi.OceanMist
Terminal=false
Categories=AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/mp3;audio/x-mp3;audio/flac;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/x-opus+ogg;audio/mp4;audio/x-m4a;audio/aac;audio/x-wav;audio/wav;
StartupWMClass=io.github.nahuelgenchi.OceanMist
StartupNotify=true
